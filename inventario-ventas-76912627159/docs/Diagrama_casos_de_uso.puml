@startuml casos_de_uso
left to right direction
skinparam packageStyle rectangle

actor "Farmacéutico\n(Usuario)" as Actor

rectangle "Sistema de Inventario - Farmacia Bendición" {
    usecase "1. Agregar producto" as UC1
    usecase "2. Consultar producto" as UC2
    usecase "3. Registrar venta" as UC3
    usecase "4. Mostrar inventario" as UC4
    usecase "5. Generar reporte" as UC5
    usecase "6. Salir y guardar" as UC6
    
    usecase "Validar stock disponible" as UC_VS
    usecase "Generar alerta de stock mínimo" as UC_Alerta
    
    Actor --> UC1
    Actor --> UC2
    Actor --> UC3
    Actor --> UC4
    Actor --> UC5
    Actor --> UC6
    
    ' Requisito de <<include>>: Registrar venta incluye obligatoriamente validar stock
    UC3 ..> UC_VS : <<include>>
    
    ' Requisito de <<extend>>: La alerta extiende la venta solo si el stock baja del umbral
    UC_Alerta ..> UC3 : <<extend>>
}
@enduml