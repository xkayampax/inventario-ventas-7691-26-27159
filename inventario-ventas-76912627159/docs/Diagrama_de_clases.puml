@startuml diagrama_clases
skinparam classAttributeIconSize 0

class SistemaInventario {
    + ejecutar() : None
    - _agregar_producto() : None
    - _consultar_producto() : None
    - _registrar_venta() : None
    - _mostrar_inventario() : None
    - _generar_reporte() : None
    - _salir() : None
}

class Inventario {
    - _productos : dict
    - _categorias : set
    + agregar(producto: Producto) : None
    + buscar_por_codigo(codigo: str) : Producto
    + buscar_por_nombre(texto: str) : list
    + obtener_ordenados(criterio: str) : list
    + __len__() : int
    + __contains__(codigo: str) : bool
    + __iter__() : Iterator
}

class Producto {
    - _precio : float
    - _stock : int
    + codigo : str
    + nombre : str
    + presentacion : str
    + categoria : str
    + descontar_stock(cantidad: int) : None
    + __str__() : str
}

class Venta << (D,orchid) dataclass >> {
    + fecha_hora : str
    + codigo_producto : str
    + cantidad : int
}

class RepositorioCSV {
    + ruta_inventario : str
    + ruta_ventas : str
    + cargar_inventario(inventario: Inventario) : None
    + guardar_inventario(inventario: Inventario) : None
    + registrar_venta(venta: Venta) : None
    + obtener_ventas_del_dia(fecha_str: str) : list
}

class Bitacora {
    + ruta : str
    + registrar(mensaje: str) : None
}

class ReporteVentas {
    + {static} mostrar_reporte_dia(ventas: list, fecha: str) : None
}

abstract class ReglaNegocio {
    + {abstract} revisar(producto: Producto) : str
}

class AlertaStockMinimo {
    + umbral : int
    + revisar(producto: Producto) : str
}

package "Excepciones" {
    class InventarioError <<Exception>>
    class PrecioInvalidoError <<Exception>>
    class StockInsuficienteError <<Exception>>
    class ProductoNoEncontradoError <<Exception>>
    
    InventarioError <|-- PrecioInvalidoError
    InventarioError <|-- StockInsuficienteError
    InventarioError <|-- ProductoNoEncontradoError
}

' Relaciones y Multiplicidades
SistemaInventario "1" *-- "1" Inventario
SistemaInventario "1" *-- "1" RepositorioCSV
SistemaInventario "1" *-- "1" Bitacora
SistemaInventario "1" *-- "1" ReglaNegocio
SistemaInventario ..> ReporteVentas : <<use>>

Inventario "1" *-- "0..*" Producto
RepositorioCSV ..> Venta : <<create/read>>
ReglaNegocio <|-- AlertaStockMinimo

@enduml